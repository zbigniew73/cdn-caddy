EXPOSURE=local
HOST=127.0.0.1
PORT=4400

AUTH_USERS=zmien-na-swoj-login,opcjonalnie-drugi-login
SESSION_SECRET=zmien-to-na-losowy-64-znakowy-hex
ALLOWED_ORIGIN=

# PAM_SERVICE=login

# Jednostka systemd Caddy (widoczna w zakladce "Uslugi"). Zmien tylko jesli
# u Ciebie faktycznie nazywa sie inaczej (`systemctl status caddy`).
CADDY_UNIT=caddy.service

# To jest SZKIELET (bez modulow) - panel na razie tylko pokazuje statystyki
# systemu i status uslugi Caddy. Zadne katalogi/tokeny/uploady klientow
# jeszcze nie istnieja - dojda jako kolejny modul (patrz caddy_cdn_gcore.md
# w repo, zakladka "Moduly" w panelu).
